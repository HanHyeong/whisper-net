{
  "name": "whisper-net",
  "version": "1.8.2",
  "description": "Serverless P2P LAN messenger",
  "main": "./out/main/index.js",
  "author": "whisper-net",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "npm run build && npx electron out/main/index.js",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.whisper-net.app",
    "productName": "Whisper Net",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  }
}
