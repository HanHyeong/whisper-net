# HMAC secret for shared folder request signing
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHISPER_HMAC_SECRET=change-me-to-a-random-32-byte-hex-string

# Master key for general (public) room encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHISPER_GENERAL_MASTER_KEY=change-me-to-another-random-32-byte-hex-string
